<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Ubicación aproximada alcanza para ordenar bares por cercanía.
         No pedimos FINE: no hace falta y es más intrusivo. El usuario
         puede conceder sólo COARSE y la app funciona igual. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application
        android:name=".BirrappApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Birrapp"
        android:usesCleartextTraffic="true">

        <!-- La key viene de local.properties vía manifestPlaceholders.
             Con REPLACE_ME el mapa carga gris: es esperado hasta el paso 3
             de docs/SETUP.md. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Birrapp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
