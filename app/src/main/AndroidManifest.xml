<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Se piden las dos. Declarar sólo COARSE fuerza precisión aproximada
         (±1-2 km), y con ese error ordenar bares "por cercanía" es ruido:
         a 2 km de margen, "a 94 m" no significa nada. Con FINE declarada,
         Android le ofrece al usuario elegir Precisa o Aproximada, y la app
         funciona con cualquiera de las dos. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application
        android:name=".BirrappApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Birrapp"
        android:usesCleartextTraffic="false">

        <!-- La key viene de local.properties vía manifestPlaceholders.
             Con REPLACE_ME el mapa carga gris: es esperado hasta el paso 3
             de docs/SETUP.md. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Birrapp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Vuelta del login por navegador. El backend redirige acá con
                 un código de un solo uso, nunca con los tokens: la URL queda
                 en el historial del navegador. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="birrapp" android:host="auth" />
            </intent-filter>
        </activity>
    </application>
</manifest>
