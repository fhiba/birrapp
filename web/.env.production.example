# Variables para el deploy en Vercel (cargar en el panel, no en el repo).

# Key de Maps restringida por referrer al dominio de Vercel.
VITE_MAPS_API_KEY=REPLACE_ME

# URL pública del backend. Sin barra final.
VITE_API_BASE=https://REPLACE_ME

# En Vercel la app va en la raíz, no bajo /app.
VITE_BASE_PATH=/
