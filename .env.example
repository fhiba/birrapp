# Copiar a .env y completar. .env está gitignoreado — nunca commitear valores reales.

# --- Base de datos ---
POSTGRES_PASSWORD=birrapp_dev
DATABASE_URL=jdbc:postgresql://localhost:5433/birrapp
DATABASE_USER=birrapp
DATABASE_PASSWORD=birrapp_dev

# --- Auth ---
# Client ID del cliente OAuth *Web* de Google Cloud.
# La app lo manda como serverClientId; el backend valida que el `aud` del
# ID token coincida con esto. Ver docs/SETUP.md.
GOOGLE_WEB_CLIENT_ID=REPLACE_ME

# Secreto para firmar los JWT propios de birrapp (NO es de Google).
# Generar con: openssl rand -base64 48
JWT_SECRET=REPLACE_ME
JWT_ISSUER=birrapp
JWT_AUDIENCE=birrapp-app
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=60

# --- Servidor ---
PORT=8090
# Interfaz donde escucha el server. En producción, detrás de un proxy
# (Tailscale Funnel / Cloudflare Tunnel), poner 127.0.0.1: así el único
# camino de entrada es el proxy y nadie en la LAN puede pegarle directo
# ni falsear el header X-Forwarded-For en que se apoya el rate limit.
BIND_HOST=0.0.0.0


# Emails que arrancan como admin (separados por coma). Quien loguee con
# uno de estos queda admin automáticamente — así hay un moderador inicial
# sin tener que tocar la base a mano.
# Poné acá la cuenta de Google con la que vas a entrar.
BOOTSTRAP_ADMIN_EMAILS=REPLACE_ME
